direction: right

classes: {
  start: { shape: rectangle; style: { fill: "#f0f0f0"; stroke: black; stroke-width: 2; border-radius: 8; font-size: 14 } }
  process: { shape: rectangle; style: { fill: white; stroke: black; stroke-width: 1; border-radius: 8; font-size: 14 } }
  result: { shape: rectangle; style: { fill: white; stroke: black; stroke-width: 1; border-radius: 8; stroke-dash: 4; font-size: 14 } }
}

container: "컨테이너\n실행 중" { class: start }
exit: "exit 입력" { class: process }
shell: "셸 종료\n(메인 프로세스)" { class: process }
stopped: "컨테이너 종료\ndocker ps에 안 보임" { class: result }

container -> exit { style.stroke: "#222222" }
exit -> shell { style.stroke: "#222222" }
shell -> stopped { style.stroke: "#222222" }
