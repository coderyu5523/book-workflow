direction: right

classes: {
  image: { shape: rectangle; style: { fill: "#f0f0f0"; stroke: black; stroke-width: 2; border-radius: 8; font-size: 14 } }
  container: { shape: rectangle; style: { fill: white; stroke: black; stroke-width: 1; border-radius: 8; font-size: 14 } }
}

image: "이미지 (읽기 전용)\nnginx:latest\n\n코드 + 런타임 + 라이브러리" { class: image }

c1: "컨테이너 1\n(실행 중)" { class: container }
c2: "컨테이너 2\n(실행 중)" { class: container }
c3: "컨테이너 3\n(실행 중)" { class: container }

image -> c1: "docker run" { style.stroke: "#222222" }
image -> c2: "docker run" { style.stroke: "#222222" }
image -> c3: "docker run" { style.stroke: "#222222" }
