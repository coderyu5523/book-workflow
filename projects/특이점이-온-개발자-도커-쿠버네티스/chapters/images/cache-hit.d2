direction: right

classes: {
  node: {
    style: {
      fill: white
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 13
    }
  }
  nginx: {
    style: {
      fill: "#e8e8e8"
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 13
    }
  }
  cache: {
    style: {
      fill: white
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 11
    }
  }
  dim: {
    style: {
      fill: "#f5f5f5"
      stroke: "#cccccc"
      stroke-width: 1
      border-radius: 6
      font-size: 13
      font-color: "#aaaaaa"
    }
  }
}

client: 클라이언트 {
  class: node
}

nginx: NGINX {
  class: nginx
  cache: "캐시: 저장됨" {
    class: cache
  }
}

backend: 백엔드 서버 {
  class: dim
}

client -> nginx: "GET /image.png" {
  style.stroke: "#222222"
  style.font-size: 11
}
nginx -> client: "캐시에서 바로 응답" {
  style.stroke: "#222222"
  style.font-size: 11
}

nginx -> backend: " " {
  style.stroke: "#cccccc"
  style.stroke-dash: 5
  style.opacity: 0.3
}
