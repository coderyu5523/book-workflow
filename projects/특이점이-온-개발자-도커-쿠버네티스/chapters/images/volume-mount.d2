direction: right

classes: {
  box: {
    style: {
      fill: white
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 13
    }
    width: 90
    height: 40
  }
  outer: {
    style: {
      fill: transparent
      stroke: black
      stroke-width: 2
      border-radius: 8
      stroke-dash: 5
      font-size: 14
    }
  }
  inner: {
    style: {
      fill: transparent
      stroke: black
      stroke-width: 1
      border-radius: 8
      stroke-dash: 3
      font-size: 12
    }
  }
  volume: {
    style: {
      fill: "#eeeeee"
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 13
    }
    width: 150
    height: 50
  }
  highlight: {
    style: {
      fill: "#f0f0f0"
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 13
    }
    width: 130
    height: 90
  }
}

host: 호스트 PC {
  class: outer

  docker-area: "Docker 내부 저장소\n/var/lib/docker/volumes/" {
    class: inner

    volume: "metacoding-volume" {
      class: volume
    }
  }
}

container: 컨테이너 (Ubuntu) {
  class: outer

  folder: "/app/volume" {
    class: highlight
    file: "b.txt" {
      class: box
    }
  }
}

host.docker-area.volume <-> container.folder: "볼륨 마운트\n(Docker가 관리)" {
  style: {
    stroke: "#222222"
    stroke-width: 2
    font-size: 12
  }
}
