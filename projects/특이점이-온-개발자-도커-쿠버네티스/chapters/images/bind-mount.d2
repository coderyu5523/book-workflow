direction: right

classes: {
  box: {
    style: {
      fill: white
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 13
    }
    width: 90
    height: 40
  }
  outer: {
    style: {
      fill: transparent
      stroke: black
      stroke-width: 2
      border-radius: 8
      stroke-dash: 5
      font-size: 14
    }
  }
  inner: {
    style: {
      fill: transparent
      stroke: black
      stroke-width: 1
      border-radius: 8
      stroke-dash: 3
      font-size: 12
    }
  }
  highlight: {
    style: {
      fill: "#f0f0f0"
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 13
    }
    width: 130
    height: 90
  }
}

host: 호스트 PC {
  class: outer

  user-dir: "사용자 지정 경로" {
    class: inner

    folder: "C:\\app\\bind" {
      class: highlight
      file: "a.txt" {
        class: box
      }
    }
  }
}

container: 컨테이너 (Ubuntu) {
  class: outer

  folder: "/app/bind" {
    class: highlight
    file: "a.txt" {
      class: box
    }
  }
}

host.user-dir.folder <-> container.folder: "바인드 마운트\n(직접 연결)" {
  style: {
    stroke: "#222222"
    stroke-width: 2
    font-size: 12
  }
}
