direction: right

classes: {
  deploy: {
    style: {
      fill: white
      stroke: black
      stroke-width: 2
      border-radius: 8
      font-size: 13
    }
  }
  pod: {
    style: {
      fill: white
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 12
    }
    width: 130
    height: 55
  }
  dead: {
    style: {
      fill: "#f5f5f5"
      stroke: "#cccccc"
      stroke-width: 1
      border-radius: 6
      stroke-dash: 4
      font-size: 12
      font-color: "#aaaaaa"
    }
    width: 130
    height: 55
  }
  new: {
    style: {
      fill: white
      stroke: black
      stroke-width: 1
      border-radius: 6
      stroke-dash: 4
      font-size: 12
    }
    width: 130
    height: 55
  }
}

deployment: "Deployment\nReplicaSet (설정 개수: 3)" {
  class: deploy
  width: 200
  height: 65
}

pods: " " {
  direction: down
  style: {
    fill: transparent
    stroke: transparent
    font-size: 8
  }

  pod1: Pod 1 {
    class: pod
  }

  pod2: Pod 2 {
    class: pod
  }

  pod3: "Pod 3\n(종료)" {
    class: dead
  }

  pod4: "Pod 4\n(자동 생성)" {
    class: new
  }
}

deployment -> pods.pod1 {
  style.stroke: "#222222"
  style.stroke-dash: 4
}
deployment -> pods.pod2 {
  style.stroke: "#222222"
  style.stroke-dash: 4
}
deployment -> pods.pod3 {
  style.stroke: "#cccccc"
  style.stroke-dash: 4
}
deployment -> pods.pod4 {
  style.stroke: "#222222"
  style.stroke-dash: 4
}
