direction: right

classes: {
  deploy: {
    style: {
      fill: white
      stroke: black
      stroke-width: 2
      border-radius: 8
      font-size: 13
    }
  }
  pod-match: {
    style: {
      fill: white
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 12
    }
  }
  pod-no: {
    style: {
      fill: "#f5f5f5"
      stroke: "#cccccc"
      stroke-width: 1
      border-radius: 6
      font-size: 12
      font-color: "#aaaaaa"
    }
  }
}

deployment: "Deployment\nselector: { app: web }" {
  class: deploy
}

pods: " " {
  direction: down
  style: {
    fill: transparent
    stroke: transparent
    font-size: 8
  }

  pod1: "Pod 1\nlabels: { app: web }" {
    class: pod-match
  }

  pod2: "Pod 2\nlabels: { app: web }" {
    class: pod-match
  }

  pod3: "Pod 3\nlabels: { app: db }" {
    class: pod-no
  }
}

deployment -> pods.pod1: "일치" {
  style: {
    stroke: "#222222"
    stroke-dash: 4
    font-size: 11
  }
}

deployment -> pods.pod2: "일치" {
  style: {
    stroke: "#222222"
    stroke-dash: 4
    font-size: 11
  }
}

deployment -> pods.pod3: "불일치" {
  style: {
    stroke: "#cc0000"
    stroke-dash: 4
    font-size: 13
    font-color: "#cc0000"
  }
}
