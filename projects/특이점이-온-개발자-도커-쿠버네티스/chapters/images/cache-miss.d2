direction: right

classes: {
  node: {
    style: {
      fill: white
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 13
    }
  }
  nginx: {
    style: {
      fill: "#e8e8e8"
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 13
    }
  }
  cache: {
    style: {
      fill: white
      stroke: black
      stroke-width: 1
      border-radius: 6
      stroke-dash: 4
      font-size: 11
    }
  }
}

client: 클라이언트 {
  class: node
}

nginx: NGINX {
  class: nginx
  cache: "캐시: 비어있음" {
    class: cache
  }
}

backend: 백엔드 서버 {
  class: node
}

client -> nginx: "GET /image.png" {
  style.stroke: "#222222"
  style.font-size: 11
}
nginx -> backend: "요청 전달" {
  style.stroke: "#222222"
  style.font-size: 11
}
backend -> nginx: "응답" {
  style.stroke: "#222222"
  style.font-size: 11
}
nginx -> client: "캐시에 저장 후 응답" {
  style.stroke: "#222222"
  style.font-size: 11
}
