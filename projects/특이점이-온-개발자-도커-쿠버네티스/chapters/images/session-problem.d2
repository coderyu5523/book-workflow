direction: right

classes: {
  node: {
    style: {
      fill: white
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 13
    }
  }
  server: {
    style: {
      fill: "#e8e8e8"
      stroke: black
      stroke-width: 1
      border-radius: 6
      font-size: 13
    }
  }
  fail: {
    style: {
      fill: "#f5f5f5"
      stroke: "#cccccc"
      stroke-width: 1
      border-radius: 6
      font-size: 13
      font-color: "#aaaaaa"
    }
  }
}

user: 사용자 {
  class: node
}

servers: " " {
  direction: down
  style: {
    fill: transparent
    stroke: transparent
    font-size: 8
  }

  server1: "서버 1 (세션 저장됨)" {
    class: server
  }

  server2: "서버 2 (세션 없음)" {
    class: fail
  }
}

user -> servers.server1: "1. 로그인" {
  style.stroke: "#222222"
  style.font-size: 11
}

user -> servers.server2: "2. 다음 요청 → 실패" {
  style.stroke: "#999999"
  style.stroke-dash: 4
  style.font-size: 11
}
